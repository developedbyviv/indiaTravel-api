# Server
PORT=5001
NODE_ENV=development

# MongoDB Atlas (Free M0 — https://cloud.mongodb.com)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/india-travel?retryWrites=true&w=majority&appName=<appName>

# JWT — Access Token (short-lived, 15 min recommended)
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=15m

# JWT — Refresh Token (long-lived, 30 days recommended)
# Falls back to JWT_SECRET if not set
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_in_production
JWT_REFRESH_EXPIRES_IN=30d

# Gmail SMTP (Free — use App Password, not your real password)
# Guide: myaccount.google.com > Security > 2-Step Verification > App passwords
GMAIL_USER=youremail@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Admin email — where enquiry notifications are sent
ADMIN_EMAIL=admin@indiatravel.net

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,https://indiatravel.net

# OTP expiry in minutes
OTP_EXPIRY_MINUTES=10

# Google OAuth Client ID (for POST /auth/google)
GOOGLE_CLIENT_ID=your_google_client_id_here
