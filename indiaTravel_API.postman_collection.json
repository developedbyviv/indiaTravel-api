{
  "info": {
    "name": "indiaTravel API",
    "description": "Postman collection for the indiaTravel.net backend REST API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5001/api",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:5001/health",
          "protocol": "http",
          "host": [ "localhost" ],
          "port": "5001",
          "path": [ "health" ]
        }
      }
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Signup",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) { pm.collectionVariables.set('token', jsonData.token); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\",\n  \"phone\": \"9876543210\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/signup", "host": [ "{{baseUrl}}" ], "path": [ "auth", "signup" ] }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) { pm.collectionVariables.set('token', jsonData.token); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": [ "{{baseUrl}}" ], "path": [ "auth", "login" ] }
          }
        },
        {
          "name": "Get Me (Protected)",
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "url": { "raw": "{{baseUrl}}/auth/me", "host": [ "{{baseUrl}}" ], "path": [ "auth", "me" ] }
          }
        }
      ]
    },
    {
      "name": "Tours",
      "item": [
        {
          "name": "Get All Tours",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/tours", "host": [ "{{baseUrl}}" ], "path": [ "tours" ] }
          }
        },
        {
          "name": "Get Tours by Category",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/tours?category=handpicked",
              "host": [ "{{baseUrl}}" ],
              "path": [ "tours" ],
              "query": [ { "key": "category", "value": "handpicked" } ]
            }
          }
        }
      ]
    },
    {
      "name": "Blogs",
      "item": [
        {
          "name": "Get All Blogs",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/blogs", "host": [ "{{baseUrl}}" ], "path": [ "blogs" ] }
          }
        }
      ]
    },
    {
      "name": "Enquiries",
      "item": [
        {
          "name": "Custom Tour Enquiry",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"region\": \"Rajasthan\",\n  \"travelStyle\": \"Luxury\",\n  \"cities\": [\"Jaipur\", \"Udaipur\"],\n  \"travelPurpose\": \"Family\",\n  \"budget\": \"Premium\",\n  \"transport\": \"SUV\",\n  \"traveller\": {\n    \"firstName\": \"John\",\n    \"lastName\": \"Doe\",\n    \"email\": \"john@example.com\",\n    \"phone\": \"9876543210\"\n  }\n}"
            },
            "url": { "raw": "{{baseUrl}}/enquiries/custom", "host": [ "{{baseUrl}}" ], "path": [ "enquiries", "custom" ] }
          }
        }
      ]
    }
  ]
}
